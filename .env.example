# No application secrets. Optional build-time public API origin override for
# isolated local/test infrastructure; default is the existing HomeMind API.
# NEXT_PUBLIC_HOMEMIND_API_ORIGIN=http://127.0.0.1:LOCAL_API_PORT
# Production release identity is set from the verified image, not from this file.
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
